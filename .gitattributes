# Auto-detect text files and normalize line endings
* text=auto

# Scripts requiring LF line endings
gradlew text eol=lf
*.sh text eol=lf

# Windows batch scripts requiring CRLF line endings
*.bat text eol=crlf
*.cmd text eol=crlf

# Source code files
*.kt text eol=lf
*.kts text eol=lf
*.java text eol=lf
*.xml text eol=lf
*.json text eol=lf
*.properties text eol=lf
*.pro text eol=lf
*.md text eol=lf

# Binary files
*.jar binary
*.aar binary
*.apk binary
*.aab binary
*.png binary
*.webp binary
*.jpg binary
*.jpeg binary
*.so binary
